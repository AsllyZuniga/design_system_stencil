  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.2.7",
    "rimraf": "^5.0.5",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  }
}