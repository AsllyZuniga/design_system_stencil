{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",

    "jsx": "react-jsx",
    "jsxImportSource": "react",

    "declaration": true,
    "declarationDir": "./dist/types",

    "outDir": "./dist",
    "rootDir": "./src",

    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "lib": ["ES2020", "DOM"]
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}