{
  "name": "@asllyzuniga/stencil-library",
  "version": "0.0.1",
  "description": "UI Web Components library",
  "private": false,
  "type": "module",
  "main": "dist-custom-elements/index.js",
  "module": "dist-custom-elements/index.js",
  "types": "dist/types.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/components.d.ts",
      "import": "./dist-custom-elements/index.js"
    },
    "./dist-custom-elements": {
      "types": "./dist/types/components.d.ts",
      "import": "./dist-custom-elements/index.js"
    },
    "./dist-custom-elements/*.js": {
      "types": "./dist-custom-elements/*.d.ts",
      "import": "./dist-custom-elements/*.js"
    },
    "./dist/types/components": {
      "types": "./dist/types/components.d.ts"
    }
  },
  "files": [
    "dist/",
    "dist-custom-elements/"
  ],
  "scripts": {
    "build": "stencil build",
    "start": "stencil build --watch --serve",
    "test": "stencil test --spec",
    "test:e2e": "stencil test --e2e"
  },
  "devDependencies": {
    "@stencil/angular-output-target": "1.1.1",
    "@stencil/core": "4.42.0",
    "@stencil/react-output-target": "0.7.1",
    "@stencil/sass": "3.1.8",
    "@types/jest": "29.5.14",
    "jest": "29.7.0",
    "jest-cli": "29.7.0",
    "puppeteer": "^24.34.0"
  }
}